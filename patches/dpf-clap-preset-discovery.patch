+#if DISTRHO_PLUGIN_WANT_PROGRAMS
+// --------------------------------------------------------------------------------------------------------------------
+// preset discovery factory (SQ8L)
+//
+// A plugin's programs are not files, so they are declared as presets held by the plugin itself:
+// one LOCATION_PLUGIN location whose presets carry the program index as their load key, which
+// clap_plugin_preset_load turns back into a loadProgram(). Indexing happens with no plugin
+// instance around, so the names come from the dummy instance the entry creates for its metadata.
+
+static const clap_preset_discovery_provider_descriptor_t* clap_preset_provider_descriptor()
+{
+    // The version of the API this provider implements: the preset headers are CLAP 1.2.6, where
+    // these ids are stable, while the rest of the vendored CLAP is 1.1.1.
+    static constexpr const clap_version_t presetDiscoveryVersion = { 1, 2, 6 };
+
+    static const clap_preset_discovery_provider_descriptor_t descriptor = {
+        presetDiscoveryVersion,
+        // The plugin's own id: a preset belongs to a plugin through add_plugin_id, but a host that
+        // wants the provider for the plugin in its hands has only the descriptor to go by, and
+        // matches this. Reaper reads the descriptor and never creates a provider named otherwise.
+        DISTRHO_PLUGIN_CLAP_ID,
+        sPlugin->getName(),
+        sPlugin->getMaker()
+    };
+
+    return &descriptor;
+}
+
+static bool CLAP_ABI clap_preset_provider_init(const clap_preset_discovery_provider_t* const provider)
+{
+    const clap_preset_discovery_indexer_t* const indexer =
+        static_cast<const clap_preset_discovery_indexer_t*>(provider->provider_data);
+    DISTRHO_SAFE_ASSERT_RETURN(indexer != nullptr, false);
+
+    // no filetype goes with it: these presets are inside the plugin, not files on disk
+    const clap_preset_discovery_location_t location = {
+        CLAP_PRESET_DISCOVERY_IS_FACTORY_CONTENT,
+        "Programs",
+        CLAP_PRESET_DISCOVERY_LOCATION_PLUGIN,
+        nullptr
+    };
+
+    return indexer->declare_location(indexer, &location);
+}
+
+static void CLAP_ABI clap_preset_provider_destroy(const clap_preset_discovery_provider_t* const provider)
+{
+    std::free(const_cast<clap_preset_discovery_provider_t*>(provider));
+}
+
+static bool CLAP_ABI clap_preset_provider_get_metadata(const clap_preset_discovery_provider_t*,
+                                                       const uint32_t location_kind,
+                                                       const char* const location,
+                                                       const clap_preset_discovery_metadata_receiver_t* const receiver)
+{
+    DISTRHO_SAFE_ASSERT_RETURN(receiver != nullptr, false);
+    DISTRHO_SAFE_ASSERT_RETURN(sPlugin != nullptr, false);
+    DISTRHO_SAFE_ASSERT_UINT_RETURN(location_kind == CLAP_PRESET_DISCOVERY_LOCATION_PLUGIN, location_kind, false);
+    // a LOCATION_PLUGIN location is null; a host that hands back an empty string means the same
+    DISTRHO_SAFE_ASSERT_RETURN(location == nullptr || location[0] == '\0', false);
+
+    static const clap_universal_plugin_id_t pluginId = { "clap", DISTRHO_PLUGIN_CLAP_ID };
+
+    char loadKey[12];
+
+    for (uint32_t i=0, count=sPlugin->getProgramCount(); i<count; ++i)
+    {
+        snprintf_u32(loadKey, i, sizeof(loadKey));
+
+        // a receiver that has had enough says so by returning false
+        if (! receiver->begin_preset(receiver, sPlugin->getProgramName(i), loadKey))
+            break;
+
+        receiver->add_plugin_id(receiver, &pluginId);
+    }
+
+    return true;
+}
+
+static const void* CLAP_ABI clap_preset_provider_get_extension(const clap_preset_discovery_provider_t*, const char*)
+{
+    return nullptr;
+}
+
+static uint32_t CLAP_ABI clap_get_preset_provider_count(const clap_preset_discovery_factory_t*)
+{
+    return 1;
+}
+
+static const clap_preset_discovery_provider_descriptor_t* CLAP_ABI
+clap_get_preset_provider_descriptor(const clap_preset_discovery_factory_t*, const uint32_t index)
+{
+    DISTRHO_SAFE_ASSERT_UINT_RETURN(index == 0, index, nullptr);
+
+    return clap_preset_provider_descriptor();
+}
+
+static const clap_preset_discovery_provider_t* CLAP_ABI
+clap_create_preset_provider(const clap_preset_discovery_factory_t*,
+                            const clap_preset_discovery_indexer_t* const indexer,
+                            const char* const provider_id)
+{
+    DISTRHO_SAFE_ASSERT_RETURN(indexer != nullptr, nullptr);
+
+    if (provider_id == nullptr || std::strcmp(provider_id, clap_preset_provider_descriptor()->id) != 0)
+        return nullptr;
+
+    clap_preset_discovery_provider_t* const provider = static_cast<clap_preset_discovery_provider_t*>(
+        std::malloc(sizeof(clap_preset_discovery_provider_t)));
+    DISTRHO_SAFE_ASSERT_RETURN(provider != nullptr, nullptr);
+
+    provider->desc = clap_preset_provider_descriptor();
+    provider->provider_data = const_cast<clap_preset_discovery_indexer_t*>(indexer);
+    provider->init = clap_preset_provider_init;
+    provider->destroy = clap_preset_provider_destroy;
+    provider->get_metadata = clap_preset_provider_get_metadata;
+    provider->get_extension = clap_preset_provider_get_extension;
+
+    return provider;
+}
+
+static const clap_preset_discovery_factory_t clap_preset_discovery_factory = {
+    clap_get_preset_provider_count,
+    clap_get_preset_provider_descriptor,
+    clap_create_preset_provider
+};
+#endif
