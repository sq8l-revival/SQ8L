+
+    void refreshSQ8LParameters(const bool schedule = true)
+    {
+        auto* const hooks = dynamic_cast<SQ8LParameterRefreshHooks*>(
+            static_cast<Plugin*>(fPlugin.getInstancePointer()));
+        float values[SQ8LParameterRefreshHooks::kParameterCount];
+        uint64_t observed = fSQ8LGeneration.load();
+        uint64_t generation = observed;
+        if (hooks == nullptr || !hooks->sq8lCopyParameterRefresh(
+                generation, values, fCachedParameters.numParams))
+            return;
+        // One election, never a realtime wait/spin. A newer snapshot can lose
+        // to an older observer; ask main to re-read even if audio stays stopped.
+        if (!fSQ8LGeneration.compare_exchange_strong(observed, generation)) {
+            fSQ8LRescan = true;
+            if (!fSQ8LRefreshRetry.exchange(true)) fHost->request_callback(fHost);
+            return;
+        }
+        for (uint32_t i=0; i<fCachedParameters.numParams; ++i)
+        {
+            fCachedParameters.values[i] = values[i];
+            fCachedParameters.changed[i] = true;
+        }
+        // Snapshot ownership has ended. request_callback is thread-safe; the
+        // host performs value/text rescan on its main thread, without gestures.
+        if (schedule && !fSQ8LRescan.exchange(true))
+            fHost->request_callback(fHost);
+    }
+
+   #if DISTRHO_PLUGIN_HAS_UI
+    void drainSQ8LUIEvents(const clap_output_events_t* const out, const uint32_t time)
+    {
+        const RecursiveMutexTryLocker locker(fEventQueue.lock);
+        if (!locker.wasLocked()) { scheduleSQ8LFlushRetry(); return; }
+        auto* const hooks = dynamic_cast<SQ8LParameterRefreshHooks*>(
+            static_cast<Plugin*>(fPlugin.getInstancePointer()));
+        const uint32_t consumed = sq8l::drainClapPanelNotifications(
+            fEventQueue.events, fEventQueue.used,
+            [hooks](const Event& event) {
+                return event.type != kEventParamSet || (hooks != nullptr &&
+                    hooks->sq8lCurrentPanelNotification(event.stamp));
+            },
+            [out, time](const Event& event) {
+                clap_event_param_value_t value = {
+                    {sizeof(clap_event_param_value_t), time, 0, CLAP_EVENT_PARAM_VALUE, CLAP_EVENT_IS_LIVE},
+                    event.index, nullptr, -1, -1, -1, -1, event.value
+                };
+                if (event.type != kEventParamSet) {
+                    value.header.size = sizeof(clap_event_param_gesture_t);
+                    value.header.type = event.type == kEventGestureBegin
+                        ? CLAP_EVENT_PARAM_GESTURE_BEGIN : CLAP_EVENT_PARAM_GESTURE_END;
+                }
+                return out != nullptr && out->try_push(out, &value.header);
+            });
+        if (consumed != 0)
+        {
+            fEventQueue.used -= consumed;
+            std::memmove(fEventQueue.events, fEventQueue.events + consumed,
+                         fEventQueue.used * sizeof(Event));
+        }
+        // Retry requests cross to main before request_flush (!audio-thread).
+        // One request per failed drain; host cooperation controls the next try.
+        if (fEventQueue.used != 0) scheduleSQ8LFlushRetry();
+    }
+   #endif
