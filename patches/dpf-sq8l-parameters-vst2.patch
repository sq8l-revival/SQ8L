+    // Dispatcher/idle only: never from parameter callbacks or processReplacing.
+    // The hook releases engine ownership before we update mirrors or notify the
+    // host. updateDisplay invalidates controls without recording automation.
+    void refreshSQ8LParameters()
+    {
+        SQ8LParameterRefreshHooks* const hooks = dynamic_cast<SQ8LParameterRefreshHooks*>(
+            static_cast<Plugin*>(fPlugin.getInstancePointer()));
+        float values[SQ8LParameterRefreshHooks::kParameterCount];
+        if (hooks == nullptr || !hooks->sq8lCopyParameterRefresh(
+                fSQ8LParameterGeneration, values, fPlugin.getParameterCount()))
+            return;
+
+        for (uint32_t i = 0; i < fPlugin.getParameterCount(); ++i)
+        {
+            parameterValues[i] = values[i];
+           #if DISTRHO_PLUGIN_HAS_UI
+            parameterChecks[i] = true;
+           #endif
+        }
+        hostCallback(VST_HOST_OPCODE_2A);
+    }
+   #endif
 
