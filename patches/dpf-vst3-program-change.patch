+        return V3_NO_INTERFACE;
+    }
+
+    // ----------------------------------------------------------------------------------------------------------------
+    // v3_unit_information
+
+    static int32_t V3_API get_unit_count(void*)
+    {
+        return 1;
+    }
+
+    static v3_result V3_API get_unit_info(void*, const int32_t unit_idx, v3_unit_info* const info)
+    {
+        DISTRHO_SAFE_ASSERT_RETURN(info != nullptr, V3_INVALID_ARG);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(unit_idx == 0, unit_idx, V3_INVALID_ARG);
+
+        std::memset(info, 0, sizeof(*info));
+        info->id = 0;
+        info->parent_unit_id = -1;
+        info->program_list_id = kDpfProgramListId;
+        strncpy_utf16(info->name, "Root", 128);
+        return V3_OK;
+    }
+
+    static int32_t V3_API get_program_list_count(void*)
+    {
+        return 1;
+    }
+
+    static v3_result V3_API get_program_list_info(void* const self, const int32_t list_idx,
+                                                  v3_program_list_info* const info)
+    {
+        DISTRHO_SAFE_ASSERT_RETURN(info != nullptr, V3_INVALID_ARG);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(list_idx == 0, list_idx, V3_INVALID_ARG);
+
+        PluginVst3* const vst3 = (*static_cast<dpf_unit_info**>(self))->vst3;
+        DISTRHO_SAFE_ASSERT_RETURN(vst3 != nullptr, V3_NOT_INITIALIZED);
+
+        std::memset(info, 0, sizeof(*info));
+        info->id = kDpfProgramListId;
+        info->programCount = static_cast<int32_t>(vst3->getProgramCount());
+        strncpy_utf16(info->name, "Programs", 128);
+        return V3_OK;
+    }
+
+    /* The plugin's own program names, the same ones the program parameter converts its value
+     * to. A host that reads the list through IUnitInfo shows these; one that only reads the
