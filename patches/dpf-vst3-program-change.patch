+    }
+
+    static v3_result V3_API get_program_pitch_name(void*, int32_t, int32_t, int16_t, v3_str_128)
+    {
+        return V3_NOT_IMPLEMENTED;
+    }
+
+    static int32_t V3_API get_selected_unit(void*)
+    {
+        return 0;
+    }
+
+    static v3_result V3_API select_unit(void*, const int32_t unit_id)
+    {
+        return unit_id == 0 ? V3_OK : V3_INVALID_ARG;
+    }
+
+    /* Every channel of the event bus maps to the one unit, which is what makes an omni
