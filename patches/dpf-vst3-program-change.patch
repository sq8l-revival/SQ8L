+    // v3_funknown
+
+    static v3_result V3_API query_interface_unit_info(void* const self, const v3_tuid iid, void** const iface)
+    {
+        dpf_unit_info* const info = *static_cast<dpf_unit_info**>(self);
+
+        if (v3_tuid_match(iid, v3_funknown_iid) ||
+            v3_tuid_match(iid, v3_unit_information_iid))
+        {
+            d_debug("query_interface_unit_info => %p %s %p | OK", self, tuid2str(iid), iface);
