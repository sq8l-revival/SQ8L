+    {
+        DISTRHO_SAFE_ASSERT_INT_RETURN(list_id == kDpfProgramListId, list_id, V3_INVALID_ARG);
+        DISTRHO_SAFE_ASSERT_INT_RETURN(program_idx >= 0, program_idx, V3_INVALID_ARG);
+
+        PluginVst3* const vst3 = (*static_cast<dpf_unit_info**>(self))->vst3;
+        DISTRHO_SAFE_ASSERT_RETURN(vst3 != nullptr, V3_NOT_INITIALIZED);
+        DISTRHO_SAFE_ASSERT_UINT_RETURN(static_cast<uint32_t>(program_idx) < vst3->getProgramCount(),
+                                        program_idx, V3_INVALID_ARG);
+
+        strncpy_utf16(name, vst3->getProgramName(static_cast<uint32_t>(program_idx)), 128);
+        return V3_OK;
+    }
+
+    static v3_result V3_API get_program_info(void*, int32_t, int32_t, const char*, v3_str_128)
